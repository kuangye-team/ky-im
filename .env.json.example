{
  "desc": [
    "local: local development; generates api/.env.local and ssg/.env.local.",
    "production: production builds and native deployments; generates api/.env.production and ssg/.env.production.",
    "compose: Docker deployment; root contains the port and npm registry, api contains runtime settings, and ssg contains frontend build arguments.",
    "wrangler: Cloudflare runtime variables, merged into each wrangler.jsonc vars; frontend build settings still come from production.ssg."
  ],
  "local": {
    "api": {
      "BIND_ADDR": "127.0.0.1:8080",
      "STATIC_DIR": "../ssg/dist",
      "CORS_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173",
      "TRUST_PROXY_HEADERS": true,
      "MAX_CONNECTIONS": 4096,
      "MAX_ROOMS": 256,
      "MAX_PEERS_PER_ROOM": 128
    },
    "ssg": {
      "WEB_PORT": 5173,
      "API_HOST": "http://127.0.0.1:8080",
      "VITE_ROOM": "local",
      "VITE_SIGNAL_URL": ""
    }
  },
  "production": {
    "api": {
      "BIND_ADDR": "127.0.0.1:8080",
      "STATIC_DIR": "../ssg/dist",
      "CORS_ORIGINS": "https://send.example.com",
      "TRUST_PROXY_HEADERS": true,
      "MAX_CONNECTIONS": 4096,
      "MAX_ROOMS": 256,
      "MAX_PEERS_PER_ROOM": 128
    },
    "ssg": {
      "VITE_ROOM": "local",
      "VITE_SIGNAL_URL": ""
    }
  },
  "compose": {
    "root": {
      "SERVER_PORT": 8080,
      "NPM_REGISTRY": "https://registry.npmjs.org/"
    },
    "api": {
      "BIND_ADDR": "0.0.0.0:8080",
      "STATIC_DIR": "/app/static",
      "CORS_ORIGINS": "",
      "TRUST_PROXY_HEADERS": true,
      "MAX_CONNECTIONS": 4096,
      "MAX_ROOMS": 256,
      "MAX_PEERS_PER_ROOM": 128
    },
    "ssg": {
      "VITE_ROOM": "local",
      "VITE_SIGNAL_URL": ""
    }
  },
  "wrangler": {
    "api": {
      "CORS_ORIGINS": "https://send.example.com",
      "MAX_CONNECTIONS": "4096",
      "MAX_ROOMS": "256",
      "MAX_PEERS_PER_ROOM": "128"
    },
    "ssg": {}
  }
}
