      "VITE_SIGNAL_URL": "",
      "VITE_API_LATEST": "/api/latest",
      "VITE_API_AUTH": "kuangye.team",
      "VITE_WEB_URL": "https://im.kuangye.team/",
      "VITE_CLIENT_DOWNLOAD_URL": "https://github.com/kuangye-team/ky-im/releases/latest",
      "VITE_STORAGE_CHUNK_SIZE": 2097152,
      "VITE_PEER_CHECK_INTERVAL_MS": 10000
    }
  },
  "desktop": {
    "app": {
      "RELEASE_VERSION": "",
      "RELEASE_NOTES": "",
      "CARGO_TARGET_DIR": "temp/cache/cargo",
      "GITHUB_REPOSITORY": "kuangye-team/ky-im",
      "TAURI_UPDATER_URL": "https://github.com/kuangye-team/ky-im/releases/latest/download/latest.json",
      "TAURI_UPDATER_PUBLIC_KEY": "",
      "TAURI_SIGNING_PRIVATE_KEY": "",
      "TAURI_SIGNING_PRIVATE_KEY_PASSWORD": "",
