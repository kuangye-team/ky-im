{
  "desc": [
    "local: local development; generates api/.env.local and ssg/.env.local.",
    "production: production builds and native deployments; generates api/.env.production and ssg/.env.production.",
    "compose: Docker deployment; root contains the port and npm registry, api contains runtime settings, and ssg contains frontend build arguments.",
    "wrangler: Cloudflare configuration merged into each wrangler.jsonc vars; api supplies runtime variables, and ssg supplies VITE_* frontend build settings (redeploy after changes).",
    "desktop: app contains signing and release settings for app/.env; ssg generates ssg/.env.desktop (development port is fixed at 1420). Desktop commands refresh these files automatically; process environment variables take precedence.",
    "ssg.VITE_API_AUTH: build-time access key for the default server; pairs with VITE_SIGNAL_URL (empty URL means same-origin); use wrangler.ssg for Cloudflare frontend builds.",
    "desktop.app: release builds require a real TAURI_UPDATER_PUBLIC_KEY and TAURI_SIGNING_PRIVATE_KEY. Keep private keys outside the repository; never commit .env.json or generated .env files."
  ],
  "local": {
    "api": {
      "BIND_ADDR": "127.0.0.1:8080",
      "STATIC_DIR": "../ssg/dist",
      "CORS_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420,http://127.0.0.1:1420",
      "TRUST_PROXY_HEADERS": true,
      "RELAY_ENABLED": false,
      "MAX_CONNECTIONS": 4096,
      "MAX_ROOMS": 256,
      "MAX_PEERS_PER_ROOM": 128,
      "API_AUTH": "kuangye.team",
      "LATEST_JSON_URL": "https://github.com/kuangye-team/ky-im/releases/latest/download/latest.json"
    },
    "ssg": {
      "WEB_PORT": 5173,
      "API_HOST": "http://127.0.0.1:8080",
      "VITE_ROOM": "local",
      "VITE_SIGNAL_URL": "",
      "VITE_API_LATEST": "/api/latest",
      "VITE_API_AUTH": "kuangye.team",
      "VITE_WEB_URL": "https://im.kuangye.team/",
      "VITE_CLIENT_DOWNLOAD_URL": "https://github.com/kuangye-team/ky-im/releases/latest",
      "VITE_STORAGE_CHUNK_SIZE": 2097152,
      "VITE_PEER_CHECK_INTERVAL_MS": 10000
    }
  },
  "production": {
    "api": {
      "BIND_ADDR": "127.0.0.1:8080",
      "STATIC_DIR": "../ssg/dist",
      "CORS_ORIGINS": "https://send.example.com,tauri://localhost,http://tauri.localhost,https://tauri.localhost",
      "TRUST_PROXY_HEADERS": true,
      "RELAY_ENABLED": false,
      "MAX_CONNECTIONS": 4096,
      "MAX_ROOMS": 256,
      "MAX_PEERS_PER_ROOM": 128,
      "API_AUTH": "kuangye.team",
      "LATEST_JSON_URL": "https://github.com/kuangye-team/ky-im/releases/latest/download/latest.json"
    },
    "ssg": {
      "VITE_ROOM": "local",
      "VITE_SIGNAL_URL": "wss://im.kuangye.team/api/ws",
      "VITE_API_LATEST": "/api/latest",
      "VITE_API_AUTH": "kuangye.team",
      "VITE_WEB_URL": "https://im.kuangye.team/",
      "VITE_CLIENT_DOWNLOAD_URL": "https://github.com/kuangye-team/ky-im/releases/latest",
      "VITE_STORAGE_CHUNK_SIZE": 2097152,
      "VITE_PEER_CHECK_INTERVAL_MS": 10000
    }
  },
  "compose": {
    "root": {
      "SERVER_PORT": 8080,
      "NPM_REGISTRY": "https://registry.npmjs.org/"
    },
    "api": {
      "BIND_ADDR": "0.0.0.0:8080",
      "STATIC_DIR": "/app/static",
      "CORS_ORIGINS": "tauri://localhost,http://tauri.localhost,https://tauri.localhost",
      "TRUST_PROXY_HEADERS": true,
      "RELAY_ENABLED": false,
      "MAX_CONNECTIONS": 4096,
      "MAX_ROOMS": 256,
      "MAX_PEERS_PER_ROOM": 128,
      "API_AUTH": "kuangye.team",
