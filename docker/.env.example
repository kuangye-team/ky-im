# Docker Hub repository; match DOCKERHUB_IMAGE when using a custom image.
IMAGE_NAME=kyteam/ky-im

# Published image tag: latest, v1.0.0, or v1.0.
IMAGE_TAG=latest

# Host port mapped to the website and signaling service.
SERVER_PORT=8080

# Set to true only behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Allow content relay only when both devices opt in; disabled by default.
RELAY_ENABLED=false

# Optional full Authorization header value, e.g. Bearer your-random-secret.
# Leave empty to allow connections without a key.
API_AUTH=

# Tauri app origins; add separate frontend origins with commas.
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
