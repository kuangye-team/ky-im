# Configure desktop.app in .env.json; npm run init and desktop commands generate app/.env.
# Process environment variables take precedence. Never commit app/.env.
# RELEASE_VERSION=1.1.0
# RELEASE_NOTES=Release notes shown in the update manifest
# CARGO_TARGET_DIR=temp/cache/cargo
# GITHUB_REPOSITORY=kuangye-team/ky-im
TAURI_UPDATER_URL=https://github.com/kuangye-team/ky-im/releases/latest/download/latest.json
# Required for release builds; keep the private key outside the repository.
# Generate once: npm run tauri signer generate -- -w /secure/path/hummingbird.key
# TAURI_UPDATER_PUBLIC_KEY=contents-of-hummingbird.key.pub
# TAURI_SIGNING_PRIVATE_KEY=/secure/path/hummingbird.key
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=your-key-password
# Optional directory hosting the signed artifacts referenced by latest.json:
# TAURI_RELEASE_BASE_URL=https://downloads.example.com/hummingbird/v1.1.0
# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
# APPLE_ID=developer@example.com
# APPLE_PASSWORD=app-specific-password
# APPLE_TEAM_ID=TEAMID
