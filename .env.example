# For the application release version, use the same value.
RELEASE_VERSION=0.1.0

# Docker settings from compose.root in .env.json.
# SERVER_PORT takes effect only when port mapping is enabled in compose.yml.
SERVER_PORT=8080
NPM_REGISTRY=https://registry.npmjs.org/

# Frontend build arguments copied from compose.ssg for Docker build.args.
VITE_ROOM=local
VITE_SIGNAL_URL=

# ICE servers, separated by commas. Empty disables external servers.
# Optional credentials: stun:host:3478?u=username&p=password (URL-encode special characters)
VITE_ICE_SERVERS=stun:stun.miwifi.com:3478,stun:stun.chat.bilibili.com:3478,stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302

# Client release manifest: same-origin path or full JSON URL (requires CORS across origins).
VITE_API_LATEST=/api/latest

# Public Web app and desktop download page (build-time configuration).
VITE_WEB_URL=https://im.kuangye.team/
VITE_CLIENT_DOWNLOAD_URL=https://github.com/kuangye-team/ky-im/releases/latest

# WebRTC message limit (1–131072 bytes), send buffer thresholds and large-file payload per record.
VITE_RTC_MAX_MESSAGE_SIZE=65536
VITE_RTC_MAX_BUFFERED_AMOUNT=1048576
VITE_RTC_BUFFERED_AMOUNT_LOW_THRESHOLD=262144
VITE_RTC_FILE_CHUNK_SIZE=262144

# Local file I/O block size. Use a multiple of 131072 from 131072 to 16777216 bytes.
VITE_STORAGE_CHUNK_SIZE=2097152

# Show file transfer speed; defaults to true. Set false to hide it.
VITE_SHOW_TRANSFER_SPEED=true

# List device checks, in milliseconds (1000–300000; default 10 seconds).
VITE_PEER_CHECK_INTERVAL_MS=10000
