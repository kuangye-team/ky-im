# Docker settings from compose.root in .env.json.
# SERVER_PORT takes effect only when port mapping is enabled in compose.yml.
SERVER_PORT=8080
NPM_REGISTRY=https://registry.npmjs.org/

# Frontend build arguments copied from compose.ssg for Docker build.args.
VITE_ROOM=local
VITE_SIGNAL_URL=

# File read / local storage block size in bytes; default 2 MiB.
# Multiple of 131072, between 131072 and 16777216. Does not change network frame size.
VITE_STORAGE_CHUNK_SIZE=2097152
