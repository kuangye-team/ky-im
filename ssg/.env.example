# Local Vite development port; not used in production.
WEB_PORT=5173

# Local proxy target for /api and WebSocket requests, without the /api/ws path.
API_HOST=http://127.0.0.1:8080

# Discovery namespace, defaulting to local. The server groups devices by
# source IP within this namespace. Automatic discovery requires both to match.
# Use 1-64 ASCII letters, digits, underscores, or hyphens.
VITE_ROOM=local

# Signaling URL. Leave empty to use /api/ws on the page's origin, suitable
# for the local development proxy and the combined Docker deployment.
# VITE_SIGNAL_URL=wss://signal.example.com/api/ws
VITE_SIGNAL_URL=
