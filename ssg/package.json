{
  "name": "im-ssg",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "deploy": "wrangler deploy",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsc --noEmit && vitest run",
    "test:desktop-updates": "playwright test --config tests/config/playwright.desktop-updates.config.ts",
    "test:browser": "playwright test --config tests/config/playwright.browser.config.ts",
    "test:pwa": "playwright test --config tests/config/playwright.pwa.config.ts",
    "test:e2e": "npm run test:browser && npm run test:relay && npm run test:pwa",
    "test:relay": "playwright test --config tests/config/playwright.relay.config.ts",
    "test:p2p": "node ../scripts/rust.mjs build --manifest-path ../app/Cargo.toml --example p2p-harness --locked && playwright test --config tests/config/playwright.p2p.config.ts"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/crypto": "5.2.0",
    "@libp2p/identify": "4.1.18",
    "@libp2p/interface": "3.4.0",
    "@libp2p/logger": "6.2.16",
    "@libp2p/peer-id": "6.0.18",
    "@libp2p/utils": "7.4.5",
    "@libp2p/webtransport": "6.0.44",
    "@multiformats/multiaddr": "13.0.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@zip.js/zip.js": "^2.24.0",
    "i18next": "^26.5.8",
    "idb": "^8.0.3",
    "libp2p": "3.5.1",
    "lucide-react": "^0.468.0",
    "multiformats": "14.0.5",
    "p-event": "8.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.1.6",
    "react-router": "^7.18.5",
    "uint8arraylist": "3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.4",
    "html-minifier-terser": "^7.2.0",
    "jsonc-parser": "^3.3.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.4",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.158.0",
    "ws": "8.23.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
