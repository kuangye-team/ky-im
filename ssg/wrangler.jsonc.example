{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ky-im-ssg",
  "compatibility_date": "2026-10-24",
  "build": { "command": "npm run build -- --mode cloudflare" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "vars": {
    "VITE_PEER_CHECK_INTERVAL_MS": "10000",
    "VITE_ROOM": "local",
    "VITE_ICE_SERVERS": "stun:stun.miwifi.com:3478,stun:stun.chat.bilibili.com:3478,stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302",
    "VITE_SIGNAL_URL": "",
    "VITE_API_LATEST": "/api/latest",
    "VITE_WEB_URL": "https://im.kuangye.team/",
    "VITE_CLIENT_DOWNLOAD_URL": "https://github.com/kuangye-team/ky-im/releases/latest",
    "VITE_RTC_MAX_MESSAGE_SIZE": "65536",
    "VITE_RTC_MAX_BUFFERED_AMOUNT": "1048576",
    "VITE_RTC_BUFFERED_AMOUNT_LOW_THRESHOLD": "262144",
    "VITE_RTC_FILE_CHUNK_SIZE": "262144",
    "VITE_STORAGE_CHUNK_SIZE": "2097152",
    "VITE_SHOW_TRANSFER_SPEED": "true",
  }
}
