# Use literal KEY=value lines, without quotes, export, or inline comments.
# The startup script creates .env from this file on first launch.

# Listening address for both the website and WebSocket signaling service.
BIND_ADDR=0.0.0.0:8080

# Relative paths are resolved from this release directory.
STATIC_DIR=./dist

# Leave empty for same-origin browser access. Separate multiple origins with commas.
CORS_ORIGINS=

# Enable only behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Connection and discovery limits.
MAX_CONNECTIONS=4096
MAX_ROOMS=256
MAX_PEERS_PER_ROOM=128
