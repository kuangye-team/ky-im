# Use literal KEY=value lines, without quotes, export, or inline comments.
# The startup script creates .env from this file on first launch.

# Listening address for both the website and WebSocket signaling service.
BIND_ADDR=0.0.0.0:8080

# Relative paths are resolved from this release directory.
STATIC_DIR=./dist

# Tauri app origins are prefilled. Add separate frontend origins with commas.
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Enable only behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Connection and discovery limits.
MAX_CONNECTIONS=4096
MAX_ROOMS=256
MAX_PEERS_PER_ROOM=128

# Allow content relay only when both devices opt in; disabled by default.
RELAY_ENABLED=false

# Optional full Authorization header value, e.g. Bearer your-random-secret.
# Leave empty to allow connections without a key.
API_AUTH=

# Upstream desktop release manifest served by /api/latest.
LATEST_JSON_URL=https://github.com/kuangye-team/ky-im/releases/latest/download/latest.json
