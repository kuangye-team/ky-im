# Listening address for HTTP and WebSocket connections.
BIND_ADDR=0.0.0.0:8080

# Frontend asset directory, relative to the API working directory.
# Start local/native deployments from api/; Docker uses /app/static.
STATIC_DIR=../ssg/dist

# Allowed frontend origins, comma-separated, without paths or trailing slashes.
# Tauri app origins are prefilled. For separate web deployments,
# set the frontend origin, for example https://send.example.com.
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Trust client IP headers forwarded by a gateway or tunnel, such as
# Forwarded and X-Forwarded-For. Enabled by default; set to false if the API
# is exposed directly to the internet without a proxy under your control.
TRUST_PROXY_HEADERS=true

# Maximum connections per signaling instance, including connections that
# have not joined a group yet. Range: 2-4096.
MAX_CONNECTIONS=4096

# Maximum discovery groups. Range: 1-256.
# Groups are identified by VITE_ROOM and the source IP observed by the server.
MAX_ROOMS=256

# Maximum online devices per discovery group. Range: 2-512.
MAX_PEERS_PER_ROOM=128

# Allow content relay only when both devices opt in; disabled by default.
RELAY_ENABLED=false

# Optional full Authorization header value, e.g. Bearer your-random-secret.
# Leave empty to allow connections without a key.
API_AUTH=
