{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ky-im-api",
  "main": "build/index.js",
  "build": { "command": "npm run build:worker", "watch_dir": "src" },
  "compatibility_date": "2026-10-24",
  "dev": { "port": 8080 },
  "durable_objects": {
    "bindings": [{ "name": "SIGNALING", "class_name": "SignalingHub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalingHub"] }],
  "vars": {
    "RELAY_ENABLED": "false",
    "CORS_ORIGINS": "tauri://localhost,http://tauri.localhost,https://tauri.localhost",
    "MAX_CONNECTIONS": "4096",
    "MAX_ROOMS": "256",
    "MAX_PEERS_PER_ROOM": "128",
  },
}
